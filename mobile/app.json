{
  "expo": {
    "name": "RecoverFlow",
    "slug": "recoverflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "recoverflow",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recoverflow.app"
    },
    "android": {
      "package": "com.recoverflow.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#8DCEF1",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://recoverflow-7vnr.onrender.com"
    }
  }
}
